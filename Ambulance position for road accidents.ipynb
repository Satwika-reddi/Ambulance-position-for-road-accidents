    "def create_week_categories(df):\n",
    "    \n",
    "    if df in ([1, 2]):\n",
    "        \n",
    "        return 'peak-days'\n",
    "    \n",
    "    if df in ([3, 4, 5]):\n",
    "        \n",
    "        return 'mid-peaks'\n",
    "    \n",
    "    else:\n",
    "        \n",
    "        return 'none'\n",
