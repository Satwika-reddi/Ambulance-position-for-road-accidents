   "source": [
    "def create_time_categories(df):\n",
    "    \n",
    "    if df in ([0, 3, 21]):\n",
    "        \n",
    "        return 'off-time'\n",
    "    \n",
    "    if df in ([6, 9]):\n",
    "        \n",
    "        return 'peak-time'\n",
    "    \n",
    "    else:\n",
    "        \n",
    "        return 'mid-time'\n",
    "    \n",
    "    "
   ]
  },
  {
