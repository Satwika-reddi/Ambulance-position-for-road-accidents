    "def bin_weather(df, col):\n",
    "    \n",
    "    bins = np.linspace(min(df[col]), max(df[col]), 4)\n",
    "\n",
    "    group_names = ['low', 'mid', 'high']\n",
    "\n",
    "    df[col + '-bin'] = pd.cut(df[col], bins, labels = group_names, include_lowest = True)\n",
    "    \n"
   ]
  },
